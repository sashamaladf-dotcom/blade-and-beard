# Telegram bot credentials for receiving booking requests.
# 1. Create a bot via @BotFather in Telegram, copy the token.
# 2. Start a chat with your bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
# 3. Copy this file to .env.local and fill in real values (do NOT commit .env.local).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
